# Copy to .env (gitignored) or let bootstrap.sh write it.
#
# There are no secrets in this file any more. Tokens and keys live in the
# `ssh`, `config`, `claude`, and `cursor` volumes, written once from inside
# the container.

# Absolute path — compose resolves relative volume sources against the compose
# file's directory, which is docker/, not the workspace.
WORKSPACE=/Users/you/localfiles

# Files written into /work land with this ownership on the host.
UID=501
GID=20

# Optional. `git config --global` inside the container persists in the config
# volume, so these are a convenience, not a requirement.
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=

TZ=Europe/Berlin
AGENT_CPUS=4
AGENT_MEM=8g
INSTALL_CURSOR=1

# Extra Fedora packages for the optional layer, space separated. zellij and
# lazygit are NOT in Fedora — install those at run time with `cargo install
# zellij` / `go install github.com/jesseduffield/lazygit@latest`, which land in
# the cache volume and persist.
EXTRA_PACKAGES=
